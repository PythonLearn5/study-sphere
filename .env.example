# Environment Variables for Study Sphere
# Copy this file to .env.local and fill in your actual values

# ==========================================
# AI / LLM 配置（统一通过 Vercel AI Gateway 调用）
# ==========================================
#  Vercel AI Gateway 官方说明：
#   - BaseURL（OpenAI 兼容协议）: https://api.vercel.com/v1/ai
#     （别名：https://ai-gateway.vercel.sh/v1 也同样可用）
#   - API Key（vck_ 开头，即 "Vercel AI Gateway Key"）：
#         https://vercel.com/dashboard/ai  →  "AI Gateway"  →  "Create API Key"
#   - 模型名格式 🔥 必填：必须写成   provider:model   （否则 Gateway 不知道走哪家后端）
#         例如：  openai:gpt-4o-mini    openai:gpt-3.5-turbo    anthropic:claude-3-haiku-20240307
#
# 推荐的常用模型（通过 Vercel AI Gateway）：
#     openai:gpt-4o-mini          （速度快 / 聊天 / 讲解 / 流程图）
#     openai:gpt-3.5-turbo        （推理强 / JSON 生成 / 闪卡 / 测验）
# 其他可选模型（需在 Vercel AI Gateway 后台绑定对应 Provider 的 Billing 账号）：
#     anthropic:claude-3-haiku-20240307
#     anthropic:claude-3-5-sonnet-20240620
#     google:gemini-1.5-flash

# ✅ 如果你使用别的 OpenAI 兼容后端（OneAPI / 自建中转 / 本地 Ollama 等），
#    直接把 LLM_BASE_URL 改成对应前缀，模型名按需填写。

LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_API_KEY=vck_your_vercel_ai_gateway_key_here

# 备用变量（兼容写法，留空即可）
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# 5 个场景的模型名。Vercel Gateway 必须是  provider:model  格式！
#  🔥 想省事？5 个都设成同一个模型（比如 openai:gpt-4o-mini，最稳妥）

LLM_MODEL_CHAT=openai:gpt-4o-mini           # 主聊天（CopilotKit / 聊天页面）
LLM_MODEL_FAST=openai:gpt-4o-mini           # 快速响应：闪卡讲解
LLM_MODEL_SMART=openai:gpt-3.5-turbo        # 复杂推理：闪卡生成 / JSON 输出
LLM_MODEL_FLOWCHART=openai:gpt-4o-mini      # 流程图生成（Mermaid）
LLM_MODEL_QUIZ=openai:gpt-3.5-turbo         # 测验生成

# ==========================================
# reCAPTCHA
# ==========================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Optional
# NEXTAUTH_SECRET=your_nextauth_secret_here
# NEXTAUTH_URL=http://localhost:3000
