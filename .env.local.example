# Environment Variables Example for Study Sphere
# Rename this file to .env.local and fill in your actual values

# ==========================================
# AI / LLM 配置（OpenAI 兼容格式，支持 Vercel AI Gateway / OneAPI / 本地 Ollama / Groq 官方 等）
# ==========================================
# 方式一：使用 Vercel AI Gateway（推荐）
#   LLM_BASE_URL  通常是: https://sdk.vercel.ai/v1  或你部署的自定义 Gateway 地址
#   LLM_API_KEY   Vercel Token
#   模型名写成:   provider:model   例如 groq:gemma2-9b-it
#
# 方式二：直接用 Groq 官方
#   不设置 LLM_BASE_URL / OPENAI_BASE_URL，只填 GROQ_API_KEY 即可
#
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# 各场景使用的模型名（改成通用、常用的 OpenAI 兼容模型名；Vercel AI Gateway 请带 provider: 前缀，如 openai:gpt-4o-mini）
#  想省事？5 个都写成同一个模型即可。
LLM_MODEL_CHAT=gpt-4o-mini
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_SMART=gpt-3.5-turbo
LLM_MODEL_FLOWCHART=gpt-4o-mini
LLM_MODEL_QUIZ=gpt-3.5-turbo

# ========= 备选模型（按需替换）=============
#  Groq 官方：gemma2-9b-it / llama-3.3-70b-versatile / llama3-8b-8192
#  Vercel AI Gateway：openai:gpt-4o-mini / openai:gpt-3.5-turbo / groq:llama-3.1-8b-instant / anthropic:claude-3-haiku-20240307
#  本地 Ollama：qwen2.5:7b / llama3.1:8b / deepseek-coder-v2

# 开发环境可以设为 true 跳过真实 AI 调用，所有 AI 路由返回 mock 回复
DISABLE_LLM=false
DISABLE_GROQ=

# 保留老配置，在没有自定义 baseURL 的时候自动用它
GROQ_API_KEY=your_groq_key_here

# ==========================================
# reCAPTCHA（申请地址: https://www.google.com/recaptcha/admin/create ）
# ==========================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Optional
# NEXTAUTH_SECRET=your_nextauth_secret_here
# NEXTAUTH_URL=http://localhost:3000
