# Environment Variables for Study Sphere
# Copy this file to .env.local and fill in your actual values

# ==========================================
# AI / LLM 配置（统一通过 Vercel AI Gateway 调用）
# ==========================================
#  Vercel AI Gateway 官方说明：
#   - BaseURL（OpenAI 兼容协议）: https://api.vercel.com/v1/ai
#     （别名：https://ai-gateway.vercel.sh/v1 也同样可用）
#   - API Key（vck_ 开头）：
#         https://vercel.com/dashboard/ai  →  "AI Gateway"  →  "Create API Key"
#   - 模型名格式 🔥 必填：必须写成   provider/model
#         例如：  openai/gpt-4o-mini    openai/gpt-3.5-turbo    anthropic/claude-3-haiku-20240307

# LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
# LLM_API_KEY=vck_xxxx_your_vercel_ai_gateway_key_here

# 备用（兼容写法）
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# 推荐的模型（Vercel Gateway: provider/model 格式）
# LLM_MODEL_CHAT=openai/gpt-4o-mini
# LLM_MODEL_FAST=openai/gpt-4o-mini
# LLM_MODEL_SMART=openai/gpt-3.5-turbo
# LLM_MODEL_FLOWCHART=openai/gpt-4o-mini
# LLM_MODEL_QUIZ=openai/gpt-3.5-turbo

# ==========================================
# reCAPTCHA
# ==========================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Optional
# NEXTAUTH_SECRET=your_nextauth_secret_here
# NEXTAUTH_URL=http://localhost:3000
